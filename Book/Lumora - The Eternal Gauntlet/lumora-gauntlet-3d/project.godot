; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Lumora Gauntlet 3D"
config/description="3D top-down Zelda-like prototype for Lumora: The Eternal Gauntlet"
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

PlayerInventory="*res://scripts/player_inventory.gd"
BuildManager="*res://scripts/build_manager.gd"
WorldManager="*res://scripts/world_manager.gd"
LumoraResources="*res://scripts/autoload/LumoraResources.gd"
PlayerResources="*res://scripts/autoload/PlayerResources.gd"
GameData="*res://scripts/autoload/game_data.gd"
CharacterManager="*res://scripts/autoload/character_manager.gd"
GemsTreasuresManager="*res://scripts/autoload/gems_treasures_manager.gd"
PlayerHouseSystem="*res://scripts/autoload/player_house_system.gd"
WorldEventManager="*res://scripts/autoload/WorldEventManager.gd"
MigrationHelper="*res://scripts/autoload/MigrationHelper.gd"

