# --- First Story NPC: Velvet ---
[ node name="Velvet" type="Area3D" parent="." ]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -9, 2, -9)
script = ExtResource("6_npc")
npc_name = "Velvet"
dialogue_lines = PackedStringArray("The Gauntlet doesn't just test your strength. It tests what you're willing to become with the pieces you take.", "Haruto used to say the ruins remember every hand that touched them. I wonder what they're learning from yours.", "Every shard you harvest... the world shifts a little. Build something worthy, or the next runner will have to tear it down.", "If you bring me an Echo Fragment from the high overlook, I'll tell you the story of the first one who ran the Gauntlet... and what they left behind.", "The crystals here remember. Listen long enough and you might hear the original pact.")
starts_quest = "velvet_echo_fragment"
quest_complete_lines = PackedStringArray("You brought it... The first runner's name was Lirael. She refused the final pact and shattered the original Gauntlet. The shards still sing her refusal. Here — take these. You'll need them more than I will.")

[ node name="CollisionShape3D" type="CollisionShape3D" parent="Velvet" ]
shape = SubResource("CapsuleShape3D_player")

