# Copy this file to .env.local on your Windows PC.
# On Vercel, set the same names in Project Settings → Environment Variables.
# Never prefix secrets with NEXT_PUBLIC_ — those are sent to the browser.

# --- Which AI brain to use ---
# ollama = local/free (default if you leave this blank)
# xai    = hosted Grok backup
# openai = official OpenAI
# custom = any other OpenAI-compatible endpoint
AI_PROVIDER=ollama

# --- MAIN: Ollama on your PC ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- BACKUP: xAI Grok on Vercel ---
# Get a key from https://console.x.ai/
# Models from https://docs.x.ai/developers/models (current chat default: grok-4.7)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.7

# Optional leftovers if you still want official OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Hosted copy lock (leave blank on your PC) ---
# Set this on Vercel so strangers cannot open your manuscripts.
APP_PASSWORD=

# Optional: only if the browser talks to a different origin
# NEXT_PUBLIC_API_URL=
