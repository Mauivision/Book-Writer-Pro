# Which AI brain to use: ollama (default, local/free) or xai (Vercel backup).
# openai and custom are also accepted.
AI_PROVIDER=ollama

# --- Ollama (main setup: your Windows PC) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- xAI Grok (backup setup: Vercel) ---
# Get a key from https://console.x.ai
# Current chat model from xAI docs: grok-4.7
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.7

# --- Optional OpenAI / custom OpenAI-compatible endpoint ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# CUSTOM_API_KEY=
# CUSTOM_BASE_URL=
# CUSTOM_MODEL=

# --- Single-user access gate ---
# Leave empty on the Windows PC so the app stays open on your Tailscale network.
# Set this on Vercel so only you can open the hosted copy.
# APP_PASSWORD=
